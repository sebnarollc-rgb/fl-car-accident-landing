# Copy to .env and fill in. NEVER commit the real .env file.

PORT=3001

# Comma-separated list of sites allowed to POST to this server
ALLOWED_ORIGINS=https://your-landing-domain.com,https://www.your-landing-domain.com

# Where new leads get emailed (comma-separate for multiple recipients)
LEAD_TO=info@sealaccidentgroup.com
MAIL_FROM="Seal Accident Group Leads <no-reply@sealaccidentgroup.com>"

# Used in the auto-reply sent to the lead (confirmation email)
FIRM_NAME=Seal Accident Group
FIRM_PHONE=(786) 449-6809

# Cloudflare Turnstile secret key (optional spam protection).
# Leave blank to disable. Get keys at dash.cloudflare.com → Turnstile.
# The matching SITE key goes in index-v3.html (TURNSTILE_SITEKEY).
TURNSTILE_SECRET=

# SMS notification on new lead (optional — leave blank to disable).
# Get these at twilio.com: Account SID, Auth Token, and a purchased number.
# SMS_TO is the firm's cell that receives the "new lead" text.
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=+15555550100
SMS_TO=+15555550123

# SMTP credentials (Gmail app password, Amazon SES, Mailgun, Postmark, etc.)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Instant lead alerts to the intake team (optional, both dormant if blank).
# Telegram — easiest: free, instant, no carrier registration.
#   1) In Telegram, message @BotFather -> /newbot -> copy the token
#   2) Create a group, add the bot + your reps, send any message in it
#   3) Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat id
# TELEGRAM_CHAT_ID accepts a comma-separated list (or one group id).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

